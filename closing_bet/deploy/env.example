# closing_bet 키움 앱키 설정 (값은 서버의 config/.env에만 넣고 커밋하지 마세요).
# (1) 전용 앱키를 쓸 수 있으면: 아래 두 줄 (collector와 반드시 다른 앱키)
CB_KIWOOM_APP_KEY=
CB_KIWOOM_SECRET_KEY=
# (2) 허용 IP당 앱키가 하나뿐이라 전용 키가 불가능하면: collector의 KIWOOM_APP_KEY/SECRET_KEY를 같이 쓰는 것을
#     명시적으로 허용 (위 두 줄은 비워 둔다). 토큰이 서로 무효화될 수 있어 WARNING이 남는다.
# CB_ALLOW_SHARED_KEY=1
